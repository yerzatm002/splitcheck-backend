# LOCAL DEVELOPMENT
# You can use SQLite first:
# DATABASE_URL=sqlite:///./splitcheck.db

# NEON
# Paste the connection string from Neon here. Both formats below are accepted.
# The app automatically converts postgresql:// to postgresql+psycopg://.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
INITIAL_USER_PASSWORD=replace-with-a-strong-initial-password
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
